# Copy to .env.local (development) or set on your server. Everything is optional for the local demo.

# Public address of the site, used in emails and payment redirects.
SITE_URL=http://localhost:3000

# Long random string for signing sign-in cookies (required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# First owner login, used once by `npm run db:seed` / `npm run db:reset`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the database and uploaded photos live (must be on persistent disk).
# DATA_DIR=./data

# Payments: set both to switch from DEMO payments to real Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: set SMTP_HOST (and the rest) to send real emails instead of logging them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Click'N'Rest <bookings@clicknrest.co.uk>"
